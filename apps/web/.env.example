# Configuración web de Firebase (es pública; la seguridad la imponen las reglas y el backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Región de Cloud Functions (debe coincidir con functions/src).
VITE_FUNCTIONS_REGION=us-central1
# Nombre de usuario del bot (sin @), para el enlace de vinculación.
VITE_TELEGRAM_BOT_USERNAME=
# Desarrollo local con `npm run emulators` (nunca en producción).
VITE_USE_EMULATORS=false
